  "cards": [
    {
      "dot": "cyan",
      "title": "Two ways to act",
      "items": [
        "Conversation: the assistant calls a service for one-off asks, lookups and judgment",
        "Flow: a durable route between services that runs without the assistant in the loop",
        "Choose by repetition and determinism, not by which one is possible"
      ]
    },
    {
      "dot": "violet",
      "title": "Identity",
      "items": [
        "The owner names the assistant at Stage 0; that name is used on every surface",
        "Baxter is only the blueprint's codename",
        "The name is a display identity, never a credential"
      ]
    },
    {
      "dot": "orange",
      "title": "Channels",
      "items": [
        "Native endpoints come from the host: desktop app, browser, phone",
        "External endpoints are enrolled messaging services: Telegram, Slack, WhatsApp, SMS",
        "At least one must reach the owner; setup sends a test message on each"
      ]
    },
    {
      "dot": "emerald",
      "title": "Automation is optional",
      "items": [
        "n8n, Zapier, Make or host routines are one connector kind, added when a flow needs one",
        "A deployment may have zero providers and zero flows",
        "Flow specs live in the workspace so a provider can be swapped without re-interviewing"
      ]
    },
    {
      "dot": "amber",
      "title": "Results, one place",
      "items": [
        "Every flow gets a run id; the ledger maps flow → run → output",
        "Check the provider first; poll a service only when the flow is native or silent",
        "A provisional flow carries an expiry until the owner promotes it"
      ]
    },
    {
      "dot": "rose",
      "title": "Where the gate bites",
      "items": [
        "Public, financial and destructive actions pause for the owner",
        "A provider that cannot pause never holds that action's credential",
        "Agent scopes and flow scopes are separate grants from the same source"
      ]
    }
  ]
