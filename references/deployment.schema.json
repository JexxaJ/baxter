{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baxter/references/deployment.schema.json",
  "title": "Baxter Deployment Config",
  "description": "Formal schema for deployment.yaml (framework §8.2), blueprint v0.2.2. Structure is enforced here; semantic cross-field rules are in `x-semantics` and validated by Baxter before any approval gate. Generated by Onboarding (§8.6), validated again by Enumerate (§8.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment",
    "harness",
    "secrets",
    "memory",
    "connectors",
    "roles",
    "channels",
    "flows",
    "approval_gates"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "assistant",
        "core_version",
        "business_context"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "Deployment identifier; must match the directory name under deployments/."
        },
        "core_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
          "description": "Pinned blueprint release (§7.2 rule 5)."
        },
        "business_context": {
          "type": "string",
          "pattern": "^[^/\\\\][^*]*\\.(md|markdown)$",
          "description": "Path to business-context.md, relative to the deployment directory."
        },
        "assistant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "description": "The owner-chosen identity used at runtime (§8.2, S19). Baxter is the blueprint codename; this is the deployment's name.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9 .'-]*$",
              "description": "Owner-chosen display name, 1–32 characters. Not a staff member's name or an authority title."
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$",
              "description": "Lowercase handle for channel endpoints; derived from the name when absent."
            },
            "pronunciation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "delivery",
        "adapter_version",
        "ports"
      ],
      "description": "The host platform and how it meets the blueprint (§9). Every degradation is declared, never inferred.",
      "properties": {
        "platform": {
          "enum": [
            "hermes",
            "rakazo",
            "grokbot",
            "nod",
            "openmausbot",
            "openclaw",
            "generic"
          ],
          "description": "Host platform. Its requirements document lives in docs/<platform>-requirements.md."
        },
        "delivery": {
          "enum": [
            "skill",
            "brief",
            "operator"
          ],
          "description": "How the instruction set reaches this host (§8.1): skill install, brief pasted into instructions, or operator runbook."
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
          "description": "Version of the host requirements document this deployment was configured against."
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "runtime",
            "instructions",
            "roles",
            "tools",
            "memory",
            "approvals",
            "files",
            "secrets",
            "scheduling",
            "audit"
          ],
          "properties": {
            "channel": {
              "$ref": "#/$defs/portState"
            },
            "runtime": {
              "$ref": "#/$defs/portState"
            },
            "instructions": {
              "$ref": "#/$defs/portState"
            },
            "roles": {
              "$ref": "#/$defs/portState"
            },
            "tools": {
              "$ref": "#/$defs/portState"
            },
            "memory": {
              "$ref": "#/$defs/portState"
            },
            "scheduling": {
              "$ref": "#/$defs/portState"
            },
            "approvals": {
              "$ref": "#/$defs/portState"
            },
            "files": {
              "$ref": "#/$defs/portState"
            },
            "secrets": {
              "$ref": "#/$defs/portState"
            },
            "audit": {
              "$ref": "#/$defs/portState"
            }
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "enum": [
              "channel",
              "runtime",
              "instructions",
              "roles",
              "tools",
              "memory",
              "scheduling",
              "approvals",
              "files",
              "secrets",
              "audit"
            ]
          },
          "uniqueItems": true,
          "description": "Ports graded degraded in this deployment. Each must name a port declared in `ports` (S16)."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "One or two sentences naming the fallback used for each degraded port."
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "description": "Where credential values live (§7.4). Never a value, always a source and a reference.",
      "properties": {
        "source": {
          "enum": [
            "vault",
            "native",
            "hybrid"
          ],
          "description": "vault: external password manager via the Secrets Service. native: the host's own encrypted store. hybrid: vault for core secrets, native for host-brokered connector grants."
        },
        "vault_path": {
          "type": "string",
          "pattern": "^vault(?:/[A-Za-z0-9][A-Za-z0-9/_-]*)?/?$",
          "description": "Root path in the external vault. Required for vault and hybrid (S17)."
        },
        "native_store": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Name of the host's native secret store, e.g. rakazo-connectors, nod-vault, hermes-profile-env. Required for native and hybrid (S17)."
        },
        "root_secret_location": {
          "type": "string",
          "maxLength": 200,
          "description": "Where the root secret lives (host file, OS keyring, TPM) and where its offline copy is kept. Never the value."
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "store",
        "location",
        "namespaces",
        "retention",
        "embeddings"
      ],
      "properties": {
        "provider": {
          "enum": [
            "core-service",
            "host-native"
          ],
          "description": "core-service is portable; host-native is opt-in and lossy (§7.5 rule 2)."
        },
        "store": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinator"
          ],
          "properties": {
            "coordinator": {
              "enum": [
                "enabled"
              ]
            },
            "content": {
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "operations": {
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "customer_engagement": {
              "enum": [
                "enabled",
                "disabled"
              ]
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summarise_after_days",
            "prune_after_days"
          ],
          "properties": {
            "summarise_after_days": {
              "type": "integer",
              "minimum": 1
            },
            "prune_after_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "embeddings": {
          "oneOf": [
            {
              "const": "off"
            },
            {
              "const": false,
              "description": "YAML 1.1 parses bare `off` as boolean false — accepted as equivalent."
            },
            {
              "const": "local"
            },
            {
              "const": "api"
            }
          ]
        }
      }
    },
    "connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "surfaces",
          "connector_pack",
          "pack_version",
          "secrets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "business",
              "automation",
              "broker"
            ],
            "description": "business: holds or moves business data. automation: builds and runs flows. broker: fronts many apps and holds their grants."
          },
          "system_of_record": {
            "type": "boolean",
            "default": false,
            "description": "Exactly one business connector may be true (S2)."
          },
          "surfaces": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "flow"
            ],
            "description": "Every connector declares both surfaces; either may be `none` (§5).",
            "properties": {
              "agent": {
                "enum": [
                  "mcp",
                  "openapi",
                  "rest",
                  "none"
                ]
              },
              "flow": {
                "enum": [
                  "rest",
                  "webhook",
                  "native",
                  "internal",
                  "none"
                ]
              }
            }
          },
          "connector_pack": {
            "type": "string",
            "pattern": "^connectors/[a-z][a-z0-9-]*\\.md$"
          },
          "pack_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
          },
          "provider": {
            "enum": [
              "n8n",
              "zapier",
              "make",
              "host-routines",
              "other"
            ],
            "description": "Required when kind is automation (S12)."
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authoring",
              "pause",
              "runs"
            ],
            "description": "Required when kind is automation (S12); defines what flows this provider is allowed to hold.",
            "properties": {
              "authoring": {
                "enum": [
                  "programmatic",
                  "manual"
                ]
              },
              "pause": {
                "type": "boolean",
                "description": "Can a flow stop and wait for an owner approval?"
              },
              "runs": {
                "type": "boolean",
                "description": "Can Baxter read run history and status?"
              }
            }
          },
          "secrets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "ref"
            ],
            "properties": {
              "source": {
                "enum": [
                  "vault",
                  "native"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "description": "Vault path or native store reference — never a value."
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.:-]*$"
                },
                "description": "Least-privilege scopes requested, e.g. contacts.read."
              },
              "rotation_days": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "automation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "provider",
                "capabilities"
              ]
            }
          }
        ]
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinator"
      ],
      "properties": {
        "coordinator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active"
          ],
          "properties": {
            "active": {
              "const": true
            }
          }
        },
        "content": {
          "$ref": "#/$defs/role"
        },
        "operations": {
          "$ref": "#/$defs/role"
        },
        "customer_engagement": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messaging",
        "approvers",
        "customer_chat"
      ],
      "properties": {
        "messaging": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "approvers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "staff": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "customer_chat": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "description": "Declared flows; provisional flows live in the run ledger, not the config. May be empty (S18).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "what",
          "spec",
          "approval"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "what": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "spec": {
            "type": "string",
            "pattern": "^flows/[a-z0-9][a-z0-9_-]*\\.md$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Connector name of an automation provider, or `native` when the vendors integrate directly. Required when the deployment has more than one automation provider (S12)."
          },
          "approval": {
            "enum": [
              "none",
              "owner"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "approval_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "private-remote",
            "local-only"
          ]
        },
        "remote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "portState": {
      "enum": [
        "native",
        "partial",
        "degraded",
        "absent"
      ],
      "description": "How the host supplies this port (§9). `partial` needs a workaround noted in the requirements document; `degraded` must also appear in harness.degraded."
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Connector names this role may touch (S3)."
        }
      }
    }
  },
  "x-semantics": [
    "S1: connectors[].name unique; kind valid; connector_pack exists; pack_version pinned.",
    "S2: exactly one business connector has system_of_record: true; automation and broker connectors may not be the system of record.",
    "S3: roles.<role>.scopes reference only names present in connectors.",
    "S4: roles.content active only with email-marketing or social; roles.operations only with crm or accounting; roles.customer_engagement only with a non-empty channels.customer_chat.",
    "S5: memory.namespaces for a specialist may be enabled only if that role is active; coordinator is always enabled.",
    "S6: flows reference declared connectors, no self-loops, unique id and unique from+to+what; spec path is present in the workspace.",
    "S7: approval_gates.default maps to a key in channels.approvers.",
    "S8: secret references are syntactically valid for their declared source and contain no values; connector secret.source matches the deployment source or is native under hybrid.",
    "S9: memory.retention.prune_after_days >= summarise_after_days.",
    "S10: no secret values anywhere in the file — references only.",
    "S11: backup.mode private-remote requires backup.remote; local-only forbids it; the remote is never public.",
    "S12: automation connectors declare provider and capabilities; a flow naming a provider references an automation connector by name (or `native`); when the deployment has more than one automation provider, every non-native flow names one.",
    "S13: a flow with approval: owner requires its provider to declare capabilities.pause = true (or provider: native with a verified pause path).",
    "S14: every flow has a spec file and, after setup Document, a run record in the ledger; a flow with no run record is an open item.",
    "S15: flows use the native vendor path wherever one exists; a native path that is declined is recorded, never silently dropped.",
    "S16: harness.degraded entries name a declared port whose value is `degraded`; the chosen delivery mode is permitted for the platform by its requirements document.",
    "S17: secrets.source vault requires vault_path; native requires native_store; hybrid requires both.",
    "S18: zero automation connectors and zero flows are valid; a flow with a non-native provider requires at least one automation connector; an automation connector with no flows is valid (added early).",
    "S19: deployment.assistant.name is chosen by the owner at onboarding Stage 0, is unique within the workspace, is not a staff member's name or an authority title, and is used on every runtime surface in place of the blueprint codename; assistant.slug matches the channel handle."
  ]
}
